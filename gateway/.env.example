# Gateway environment (copy to .env — do not commit secrets)

# Prometheus metrics at GET /metrics (login_blocked_total, login_failures_total)

GATEWAY_LISTEN=0.0.0.0:3000
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRY_SECS=3600
INTERNAL_TOKEN=change-me-internal-token
USER_SERVICE_URL=http://127.0.0.1:8082
AUDIT_SERVICE_URL=http://127.0.0.1:8084
WORKFLOW_SERVICE_URL=http://127.0.0.1:8085
SEARCH_SERVICE_URL=http://127.0.0.1:8086
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8087
FILE_SERVICE_URL=http://127.0.0.1:8088
# Decoded file max 50 MiB; request body max ~70 MiB (base64 JSON envelope).
FILE_MAX_BYTES=52428800
FILE_MAX_REQUEST_BODY_BYTES=73400320
REDIS_URL=redis://127.0.0.1:6379
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECS=60
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
WEB_APP_URL=http://127.0.0.1:5173
# OIDC SSO (Authentik / Keycloak) — all four required plus REDIS_URL to enable
# OIDC_ISSUER_URL=https://auth.example.com/application/o/gateframe/
# OIDC_CLIENT_ID=gateframe
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://127.0.0.1:3002/api/auth/oidc/callback
# OIDC_TENANT_SLUG=default
